{
  "name": "freshguard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "保鲜管家 FreshGuard - 物品保质期识别与提醒（前端交互侧）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "test:parser": "esbuild scripts/test-parser.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/test-parser.mjs && node node_modules/.tmp/test-parser.mjs",
    "smoke": "esbuild scripts/smoke-render.tsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.css=empty --outfile=node_modules/.tmp/smoke.cjs && node node_modules/.tmp/smoke.cjs",
    "verify": "npm run typecheck && npm run test:parser && npm run smoke && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
